FUNCTION_BLOCK Ghost

VAR_INPUT
   comestible : REAL;
   tiempo : REAL;
   distPacman : REAL;
   distAliado : REAL;
   soy : REAL;
   desvio : REAL;
END_VAR

VAR_OUTPUT
   perseguir : REAL;
   huir : REAL;
   interceptar : REAL;
END_VAR

FUZZIFY comestible
   TERM no := (0, 1) (1, 0);
   TERM si := (0, 0) (1, 1);
END_FUZZIFY

FUZZIFY tiempo
   TERM casi := (0, 1) (8, 1) (28, 0);
   TERM medio := trian 12 33 62;
   TERM largo := (39, 0) (73, 1) (280, 1);
END_FUZZIFY

FUZZIFY distPacman
   TERM encima := (0, 1) (4, 1) (11, 0);
   TERM cerca := (0, 1) (10, 1) (24, 0);
   TERM media := trian 17 40 68;
   TERM lejos := (46, 0) (78, 1) (150, 1);
   TERM hayDesvio := (13, 0) (16, 1) (150, 1);
END_FUZZIFY

FUZZIFY distAliado
   TERM juntos := (0, 1) (4, 1) (16, 0);
   TERM separados := (12, 0) (27, 1) (150, 1);
END_FUZZIFY

FUZZIFY soy
   TERM blinky := trian -0.5 0 0.5;
   TERM pinky := trian 0.5 1 1.5;
   TERM inky := trian 1.5 2 2.5;
   TERM sue := trian 2.5 3 3.5;
   TERM cortador := (0.5, 0) (1, 1) (2, 1) (2.5, 0);
END_FUZZIFY

FUZZIFY desvio
   TERM bueno := (-200, 1) (7, 1) (10, 0);
   TERM ajustado := trian 3 8 13;
   TERM malo := (9, 0) (17, 1) (200, 1);
END_FUZZIFY

DEFUZZIFY perseguir
   TERM baja := (0, 1) (3.8, 0);
   TERM normal := trian 2.7 5 7.3;
   TERM alta := trian 5.9 7.4 8.9;
   TERM urgente := trian 7.8 8.8 9.8;
   RANGE := (0 .. 10);
   METHOD : COG;
   DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huir
   TERM baja := (0, 1) (3.3, 0);
   TERM normal := trian 3 5.3 7.6;
   TERM alta := trian 5.8 7.8 9.8;
   TERM urgente := (7.2, 0) (10, 1);
   RANGE := (0 .. 10);
   METHOD : COG;
   DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY interceptar
   TERM baja := (0, 1) (3, 0);
   TERM media := trian 5.2 6.9 8.5;
   TERM alta := trian 7.3 8.8 10;
   RANGE := (0 .. 10);
   METHOD : COG;
   DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK reglas
   AND : MIN;
   OR : MAX;
   ACT : MIN;
   ACCU : MAX;

   // huida: tiempo comestible y distancia al perseguidor
   RULE 1 : IF comestible IS si THEN huir IS normal;
   RULE 2 : IF comestible IS si AND distPacman IS encima THEN huir IS urgente;
   RULE 3 : IF comestible IS si AND distPacman IS cerca AND tiempo IS medio THEN huir IS alta;
   RULE 4 : IF comestible IS si AND distPacman IS cerca AND tiempo IS largo THEN huir IS urgente;
   RULE 5 : IF comestible IS si AND distPacman IS media AND tiempo IS largo THEN huir IS alta;
   RULE 6 : IF comestible IS si AND distPacman IS lejos AND tiempo IS largo THEN huir IS alta;
   RULE 7 : IF comestible IS si AND distAliado IS juntos AND tiempo IS medio THEN huir IS alta;
   RULE 8 : IF comestible IS si AND tiempo IS casi AND NOT distPacman IS cerca THEN huir IS normal;
   RULE 9 : IF comestible IS si THEN perseguir IS baja;
   RULE 10 : IF comestible IS no THEN huir IS baja;

   // persecucion: diferentes grados de presion sin perder la salida de reserva
   RULE 11 : IF comestible IS no THEN perseguir IS normal;
   RULE 12 : IF comestible IS no AND distPacman IS encima THEN perseguir IS urgente;
   RULE 13 : IF comestible IS no AND distPacman IS cerca THEN perseguir IS alta;
   RULE 14 : IF comestible IS no AND soy IS blinky AND distPacman IS media THEN perseguir IS alta;
   RULE 15 : IF comestible IS no AND soy IS blinky AND distPacman IS lejos THEN perseguir IS alta;
   RULE 16 : IF comestible IS no AND soy IS pinky AND distPacman IS cerca AND distAliado IS separados THEN perseguir IS urgente;
   RULE 17 : IF comestible IS no AND soy IS pinky AND distPacman IS media AND distAliado IS juntos THEN perseguir IS baja;
   RULE 18 : IF comestible IS no AND soy IS inky AND distPacman IS encima THEN perseguir IS alta;
   RULE 19 : IF comestible IS no AND soy IS inky AND distPacman IS media AND distAliado IS juntos THEN perseguir IS baja;
   RULE 20 : IF comestible IS no AND soy IS sue AND distPacman IS media AND distAliado IS separados THEN perseguir IS alta;
   RULE 21 : IF comestible IS no AND soy IS sue AND distPacman IS lejos AND distAliado IS juntos THEN perseguir IS baja;
   RULE 22 : IF comestible IS no AND distPacman IS lejos AND distAliado IS separados THEN perseguir IS alta;
   RULE 23 : IF comestible IS no AND soy IS sue AND distPacman IS cerca AND distAliado IS juntos THEN perseguir IS urgente;
   RULE 24 : IF comestible IS no AND soy IS blinky AND distPacman IS cerca AND distAliado IS separados THEN perseguir IS urgente;

   // intercepcion: pinky e inky cortan el pasillo si el desvio compensa
   RULE 25 : IF comestible IS no AND soy IS cortador AND distPacman IS hayDesvio AND desvio IS bueno THEN interceptar IS alta;
   RULE 26 : IF comestible IS no AND soy IS cortador AND distPacman IS media AND desvio IS ajustado THEN interceptar IS media;
   RULE 27 : IF comestible IS no AND soy IS cortador AND distPacman IS lejos AND desvio IS ajustado THEN interceptar IS media;
   RULE 28 : IF comestible IS no AND soy IS cortador AND NOT distPacman IS hayDesvio THEN interceptar IS baja;
   RULE 29 : IF comestible IS no AND soy IS cortador AND NOT desvio IS bueno THEN interceptar IS baja;
   RULE 30 : IF comestible IS no AND soy IS cortador AND desvio IS malo AND distPacman IS lejos THEN perseguir IS alta;
   RULE 31 : IF comestible IS no AND soy IS cortador AND desvio IS malo AND distPacman IS media THEN perseguir IS alta;
   RULE 32 : IF comestible IS si THEN interceptar IS baja;
   RULE 33 : IF comestible IS no AND NOT soy IS cortador THEN interceptar IS baja;
   RULE 34 : IF comestible IS no AND soy IS cortador AND distPacman IS hayDesvio AND desvio IS bueno AND distAliado IS juntos THEN perseguir IS baja;
END_RULEBLOCK

END_FUNCTION_BLOCK
